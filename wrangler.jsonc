{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdwn-local",
  "compatibility_date": "2026-09-18",
  "main": "./workers/app.ts",
  // Public donation addresses for the anonymous /support page (not secrets).
  // Leave a value empty to hide that asset; override locally in .dev.vars.
  "vars": {
    "APP_ENV": "local",
    "SUPPORT_MONERO_ADDRESS": "",
    "SUPPORT_BITCOIN_ADDRESS": "",
    "SUPPORT_LIGHTNING_ADDRESS": "",
    "SUPPORT_ETHEREUM_ADDRESS": "0x5399A7a61d553936A2B7d5a8fA75Ce7B4534D1CA"
  },
  // The privacy policy disables blanket invocation logs and traces; only
  // explicitly allowlisted Security events are persisted in D1.
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdwn-db",
      "database_id": "c466a7b4-5cd9-4993-8041-705e173622d4",
      "migrations_dir": "./drizzle"
    }
  ],
  "env": {
    "preview": {
      "name": "mdwn-preview",
      "vars": {
        "APP_ENV": "preview",
        "SUPPORT_MONERO_ADDRESS": "",
        "SUPPORT_BITCOIN_ADDRESS": "",
        "SUPPORT_LIGHTNING_ADDRESS": "",
        "SUPPORT_ETHEREUM_ADDRESS": "0x5399A7a61d553936A2B7d5a8fA75Ce7B4534D1CA"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mdwn-db-preview",
          "database_id": "9f7eeb4f-9fc4-4e68-8c42-5159f215f17b",
          "migrations_dir": "./drizzle"
        }
      ]
    },
    "production": {
      "name": "mdwn",
      "routes": [{ "pattern": "mdwn.me", "custom_domain": true }],
      // Deployment readiness still probes the workers.dev URL.
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
        "SUPPORT_MONERO_ADDRESS": "",
        "SUPPORT_BITCOIN_ADDRESS": "",
        "SUPPORT_LIGHTNING_ADDRESS": "",
        "SUPPORT_ETHEREUM_ADDRESS": "0x5399A7a61d553936A2B7d5a8fA75Ce7B4534D1CA"
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mdwn-db-production",
          "database_id": "20cbcf9f-0408-48d8-8e51-c8a7385435ef",
          "migrations_dir": "./drizzle"
        }
      ]
    }
  }
}
