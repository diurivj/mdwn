{
  "extends": "./tsconfig.json",
  "files": ["app/import/visibility.server.ts"],
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "tests/fixtures/*.json",
    "e2e/**/*.ts",
    "app/db/**/*.ts",
    "app/security/**/*.ts",
    "app/crypto/**/*.ts",
    "app/comments/content.ts",
    "app/comments/public-content.ts",
    "app/archive/**/*.ts",
    "app/export/collect.ts",
    "app/import/**/*.ts",
    "app/publications/capability.ts",
    "app/publications/content.ts",
    "app/comments/comments-client.ts",
    "app/account/profile-client.ts",
    "app/auth/recovery-codes.ts",
    "app/device/store.ts",
    "app/device/proof.ts",
    "app/device/private-client.ts",
    "app/device/private-browser.ts",
    "app/device/owned-provision-client.ts",
    "app/signup/protocol.ts",
    "app/namespace-v1/**/*.ts",
    "app/opaque-id.ts",
    "app/signup/recovery-gate.ts",
    "app/support/donations.ts",
    "app/tree/client.ts",
    "app/tree/listing.ts",
    "app/tree/wire.ts",
    "app/tree/subtree.server.ts",
    "app/tree/file-client.ts",
    "app/tree/file-head.ts",
    "app/tree/file-capability-client.ts",
    "app/sharing/grant-keys.ts",
    "app/sharing/comment-keys.ts",
    "app/sharing/rotation-client.ts",
    "app/sharing/provisioning-client.ts",
    "app/sharing/rotation-wire.ts"
  ],
  "exclude": ["tests/worker/**/*", "app/import/*.server.ts"],
  "compilerOptions": {
    "composite": true,
    "paths": { "~/*": ["./app/*"] },
    "strict": true,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  }
}
