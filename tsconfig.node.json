{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "tests/fixtures/*.json",
    "e2e/**/*.ts",
    "app/db/**/*.ts",
    "app/security/**/*.ts",
    "app/crypto/**/*.ts",
    "app/tree/file-head.ts",
    "app/device/store.ts",
    "app/device/proof.ts",
    "app/device/private-client.ts",
    "app/signup/protocol.ts",
    "app/namespace-v1/**/*.ts"
  ],
  "exclude": ["tests/worker/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  }
}
