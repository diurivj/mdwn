{
  "name": "mdwn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:preview": "CLOUDFLARE_ENV=preview react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node scripts/apply-migrations.mjs local",
    "db:migrate:preview": "node scripts/apply-migrations.mjs preview",
    "db:migrate:production": "node scripts/apply-migrations.mjs production",
    "db:smoke": "node scripts/smoke-db.mjs",
    "db:smoke:preview": "node scripts/smoke-db.mjs --remote preview",
    "db:smoke:production": "node scripts/smoke-db.mjs --remote production",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "check:namespace": "node scripts/generate-namespace-v1-data.mjs --check",
    "deploy:preview": "node scripts/deploy-worker.mjs preview",
    "deploy:production": "node scripts/deploy-worker.mjs production",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hpke/core": "1.9.0",
    "@react-router/cloudflare": "^8.4.0",
    "@scure/bip39": "1.5.4",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
